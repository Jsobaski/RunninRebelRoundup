# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables.

# ESPN's unofficial team id for UNLV men's basketball. Verify against
# https://site.api.espn.com/apis/site/v2/sports/basketball/mens-college-basketball/teams/2439
# before relying on it — ESPN doesn't publish a stable id lookup.
ESPN_UNLV_TEAM_ID=2439

# Season used for ESPN stats/schedule queries (their `season` query param).
NEXT_PUBLIC_SEASON=2026

# X (Twitter) List URL to embed on the home feed's Social tab. Create a
# List of @UNLVMBB, beat writers, and conference accounts, then paste its
# URL here. Leave unset to show a placeholder instead of the embed.
NEXT_PUBLIC_X_LIST_URL=https://twitter.com/i/lists/XXXXXXXXXXXXXXXXX

# Overrides for the roster/recruiting scraper targets. Defaults point at
# UNLV's official roster page and a 247Sports commits page — update if
# either site's URL structure changes.
UNLV_ROSTER_URL=https://unlvrebels.com/sports/mens-basketball/roster
UNLV_RECRUITING_URL=https://247sports.com/college/unlv/Season/2027-Basketball/Commits/

# Shared secret checked against the Authorization header on
# /api/cron/refresh so only Vercel Cron (which sends it automatically) can
# trigger a manual ISR revalidation. Optional locally; set it on Vercel.
CRON_SECRET=
